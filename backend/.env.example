# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Segredo usado para assinar os JWTs. Obrigatorio; a aplicacao nao sobe sem ele.
# Gere um valor forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me"
# Duracao dos tokens (formatos aceitos pelo @nestjs/jwt, ex.: 15m, 8h, 7d)
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Usuario administrador criado automaticamente no primeiro boot, quando ainda nao existe nenhum usuario.
# Ele e obrigado a trocar a senha no primeiro login.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@thestock.local"
ADMIN_PASSWORD="admin123"

# Origem do frontend autorizada pelo CORS (vazio desabilita o CORS)
CORS_ORIGIN="http://localhost:5173"
