# Copy to `.env` (same folder as compose.yaml). Every variable has a default in compose.yaml,
# so this file is only needed to change something.

# Host ports. The browser calls the API directly, so these also drive NEXT_PUBLIC_API_URL
# and CORS_ORIGIN unless you set those explicitly below.
API_PORT=3000
WEB_PORT=3001

# PostgreSQL (internal to the compose network; see compose.yaml to publish the port).
POSTGRES_USER=thestock
POSTGRES_PASSWORD=thestock
POSTGRES_DB=thestock

# API secrets and settings. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Initial administrator (created on the first boot of an empty database; must change the password on first login).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@thestock.local
ADMIN_PASSWORD=admin123

# Only needed when the app is reached through another host/port than localhost:API_PORT / localhost:WEB_PORT.
# NEXT_PUBLIC_API_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3001

THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=10
